{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/harness-eval/score-v0.2.proposed.schema.json",
  "$comment": "Proposed future contract only. Current score-spreadsheetbench.py emits record_version 0.1 and does not validate against this schema.",
  "title": "Proposed Harness evaluation score record v0.2",
  "type": "object",
  "required": ["record_version", "run_id", "case_id", "scope", "status", "benchmark_score", "execution_gate", "benchmark_gate", "evaluator", "answer", "output", "detail"],
  "properties": {
    "record_version": { "const": "0.2" },
    "run_id": { "type": ["string", "null"] },
    "case_id": { "type": "string" },
    "scope": { "const": "single_test_case_smoke" },
    "status": { "enum": ["passed", "failed"] },
    "benchmark_score": { "type": "null" },
    "execution_gate": { "type": "object" },
    "benchmark_gate": { "type": "object" },
    "evaluator": { "type": "object" },
    "answer": { "type": "object" },
    "output": { "type": "object" },
    "detail": {}
  },
  "additionalProperties": true
}
